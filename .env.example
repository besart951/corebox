# Copy to .env and fill these values. Never commit .env.
POSTGRES_PASSWORD=
FOUNDATION_DATABASE_URL=
EXAMPLE_DATABASE_URL=
EXAMPLE_JWT_SECRET=
EXAMPLE_ENCRYPTION_KEY=
EXAMPLE_PUBLIC_URL=http://localhost:8000
EXAMPLE_SENDER_EMAIL=noreply@example.com
EXAMPLE_CORS_ORIGINS=[]
EXAMPLE_JOBS_ENABLED=true
